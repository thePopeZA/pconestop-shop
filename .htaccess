# ============================================================
#  PC One Stop Shop — Apache config
# ============================================================

# Deny access to sensitive files/dirs
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/?(config|includes|lib|database|storage)(/.*)?$
# Block the Git metadata dir from the web (cPanel Git clones .git into the docroot).
RedirectMatch 403 ^/?\.git(/.*)?$
# Cron scripts are CLI-only and stay web-blocked — EXCEPT the daily promo mailer,
# which has a key-protected manual web trigger for testing. (fetch_feed.php and
# commission_report.php also self-guard with a PHP_SAPI==='cli' check.)
RedirectMatch 403 ^/?cron/(?!daily-promo-email\.php$).*$

# Pretty error pages
ErrorDocument 404 /404.php

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>

Options -Indexes
